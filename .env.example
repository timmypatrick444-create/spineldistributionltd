# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# ADMIN CREDENTIALS FOR /admin LOGIN:
# Technical Email ID and Access Key for secure Admin Dashboard access
ADMIN_TECHNICAL_EMAIL="admin@enterprise.sec"
ADMIN_ACCESS_KEY="YOUR_ADMIN_ACCESS_KEY"

# JWT SECRET FOR AUTHENTICATION & SESSIONS:
JWT_SECRET="your-strong-jwt-secret-key-min-32-chars"

# REAL-TIME EXCHANGE RATE (USD to NGN):
# Parsed dynamically through environment variable on the server
USD_TO_NGN_RATE="1550"

# SUPABASE DATABASE & AUTH INTEGRATION:
# Connect your Supabase project (URL and keys). The server will use these
# to persist products, users, orders, and sessions.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PAYSTACK PAYMENT INTEGRATION:
# Enter your Paystack Secret and Public keys for live/test checkout
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
